# Copy to .env.local. Only the publishable (anon) key belongs here; never put the service_role key in the web app.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Public address of the site: canonical links, Open Graph URLs, sitemap and robots.txt. Without it the app uses the
# Vercel production domain, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://<your-domain>
