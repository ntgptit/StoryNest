{
  "name": "storynest",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "gate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm check:hardcode && pnpm check:tokens && pnpm db:types:check && pnpm db:verify && pnpm --filter @storynest/web build",
    "db:verify": "bash supabase/scripts/verify-migrations.sh",
    "db:types": "bash supabase/scripts/gen-types.sh",
    "db:types:check": "bash supabase/scripts/gen-types.sh --check",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:feature": "node scripts/gen-feature.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:hardcode": "node scripts/check-hardcode.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
